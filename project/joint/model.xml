<mujoco model="one_joint_teaching">
  <!-- Teaching model only: values below are assumptions, not identified hardware. -->
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint limited="true" range="-1.05 1.05" damping="0.06" armature="0.002"/>
    <geom contype="0" conaffinity="0"/>
  </default>
  <worldbody>
    <geom name="ground" type="plane" size="1 1 .01" rgba=".2 .25 .3 1"/>
    <body name="arm" pos="0 0 .55">
      <joint name="joint" type="hinge" axis="0 1 0"/>
      <geom name="link" type="capsule" fromto="0 0 0 0 0 -.32" size=".025" mass=".25" rgba=".2 .8 .6 1"/>
    </body>
  </worldbody>
  <!-- Position target [rad] in ctrl, a simplified PD servo with torque saturation [N m]. -->
  <actuator>
    <position name="servo" joint="joint" kp="6" kv="0.25" ctrllimited="true" ctrlrange="-.9 .9" forcelimited="true" forcerange="-1.5 1.5"/>
  </actuator>
</mujoco>
